# Default provider is xAI. Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# The official Python SDK (xai-sdk) authenticates with XAI_API_KEY and talks
# gRPC to api.x.ai. The OpenAI-compatible REST base URL is https://api.x.ai/v1
# (see https://docs.x.ai/developers/quickstart).

LLM_PROVIDER=xai

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7

# Optional alternative providers — used when LLM_PROVIDER=openai or anthropic.
# Kept so you can learn their tool-calling and structured-output APIs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

LLM_TEMPERATURE=0.2
MAX_TOOL_ITERATIONS=5
LLM_TIMEOUT_SECONDS=60
TOOL_HTTP_TIMEOUT_SECONDS=8

# Postgres / pgvector — used from Day 2. The Day 1 API does not query it yet.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
