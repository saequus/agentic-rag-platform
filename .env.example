# Default provider is xAI. Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# The official Python SDK (xai-sdk) authenticates with XAI_API_KEY and talks
# gRPC to api.x.ai. The OpenAI-compatible REST base URL is https://api.x.ai/v1
# (see https://docs.x.ai/developers/quickstart).

LLM_PROVIDER=xai

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7

# Optional alternative providers — used when LLM_PROVIDER=openai or anthropic.
# Kept so you can learn their tool-calling and structured-output APIs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# gpt-5-nano and the other gpt-5 / o-series models only accept the default
# temperature (1). The OpenAI adapter omits this field for those models.
LLM_TEMPERATURE=0.2
MAX_TOOL_ITERATIONS=5
LLM_TIMEOUT_SECONDS=60
TOOL_HTTP_TIMEOUT_SECONDS=8

# Postgres / pgvector (Day 2). Default matches the local Postgres.app
# database already created on the development Mac (trust auth, pgvector 0.8.7).
# docker compose overrides this to postgresql://rag:rag@postgres:5432/rag.
DATABASE_URL=postgresql://slava@localhost:5432/agentic_rag

# Embeddings. "local" (default) uses sentence-transformers; "openai" needs
# OPENAI_API_KEY; "hash" is a deterministic backend for tests.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Alternative local model: BAAI/bge-m3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=16
DEFAULT_TENANT_ID=default
HNSW_EF_SEARCH=40

# Day 3 retrieval. /search can override strategy and backend per request.
# dense | sparse | hybrid | hybrid_rerank
RETRIEVAL_STRATEGY=hybrid
# pgvector | qdrant
RETRIEVAL_BACKEND=pgvector
RETRIEVAL_CANDIDATES=50
RRF_K=60
# rrf | dbsf (Qdrant only; pgvector hybrid is always RRF)
QDRANT_FUSION=rrf
# Qdrant server (docker compose / binary). Leave empty to use embedded mode at
# QDRANT_PATH (no server; one process at a time can open the folder).
# QDRANT_URL=http://127.0.0.1:6333
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=chunks
# Multilingual alternative (Polish): BAAI/bge-reranker-v2-m3 (~2.3 GB, slower on CPU)
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# OpenTelemetry (optional). Tracing is off until an exporter endpoint is set.
# Official variables: https://opentelemetry.io/docs/languages/sdk-configuration/
# OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=agentic-rag-platform
# local | staging | production — goes on the Resource, not on every span.
# OTEL_ENVIRONMENT is read by this app as the deployment.environment resource.
OTEL_ENVIRONMENT=local
# Collector or Jaeger OTLP HTTP base URL (the exporter appends /v1/traces).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# otlp | console | otlp,console  (console prints spans to stdout; useful without Docker)
OTEL_TRACES_EXPORTER=otlp
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# Keep prompts, tool arguments and retrieved text off spans (default true).
OTEL_REDACT_CONTENT=true

# Day 4 LangGraph agent (POST /chat, /chat/stream, /chat/resume).
# postgres = thread state in DATABASE_URL (tables created by AsyncPostgresSaver.setup());
# memory = per-process only.
AGENT_CHECKPOINTER=postgres
AGENT_RECURSION_LIMIT=25
AGENT_MAX_REWRITES=2
# Per-turn LLM-call budget kept in graph state (route + grade + generate + grounding = 4).
AGENT_MAX_LLM_CALLS=10
AGENT_NODE_TIMEOUT_SECONDS=45
AGENT_TOP_K=5
AGENT_HISTORY_TURNS=4
# Optional: agent-only retrieval defaults (otherwise RETRIEVAL_STRATEGY / RETRIEVAL_BACKEND).
# AGENT_RETRIEVAL_STRATEGY=hybrid_rerank
# AGENT_RETRIEVAL_BACKEND=pgvector

# docker compose only: OTLP endpoint *inside* the api container (service name, not 127.0.0.1).
# DOCKER_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
