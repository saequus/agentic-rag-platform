    {
      "name": "Search",
      "description": "Vector search over ingested chunks. Body: `{ query, tenant_id?, k?, ef_search? }`. Requires a previous successful ingest for the given tenant.",
      "item": [
        {
          "name": "Polish query (EDO bond coupon)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('JSON shape: hits[], model, tenant_id', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('object');",
                  "  pm.expect(body).to.have.property('hits').that.is.an('array');",
                  "  pm.expect(body).to.have.property('model').that.is.a('string');",
                  "  pm.expect(body).to.have.property('tenant_id').that.is.a('string');",
