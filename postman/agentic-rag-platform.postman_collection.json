          "name": "Plain question",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('JSON shape: structured Answer plus provider metadata', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('object');",
                  "  pm.expect(body).to.have.property('answer').that.is.a('string').and.to.have.lengthOf.at.least(1);",
                  "  pm.expect(body).to.have.property('citations').that.is.an('array');",
                  "  pm.expect(body).to.have.property('confidence').that.is.a('number');",
                  "  pm.expect(body.confidence).to.be.at.least(0).and.to.be.at.most(1);",
                  "  pm.expect(body).to.have.property('provider').that.is.a('string');",
                  "  pm.expect(body).to.have.property('model').that.is.a('string');",
                  "  pm.expect(body).to.have.property('tool_calls').that.is.an('array');",
                  "});",
                  ""
                ]
              }
            }
          ],
