    {
      "name": "Ingest",
      "description": "Lab endpoint: `source_path` is a local file or directory on the API host, not an upload. The full-corpus request is slow; use the single-file request for a quick check.",
      "item": [
        {
          "name": "Ingest corpus (data/raw)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('JSON shape: tenant_id and documents[]', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('object');",
                  "  pm.expect(body).to.have.property('tenant_id').that.is.a('string');",
                  "  pm.expect(body).to.have.property('documents').that.is.an('array');",
                  "  if (body.documents.length > 0) {",
                  "    const doc = body.documents[0];",
                  "    ['doc_id', 'pages', 'chunks', 'embedded', 'skipped', 'deleted'].forEach(function (key) {",
                  "      pm.expect(doc).to.have.property(key);",
                  "    });",
                  "  }",
                  "});",
                  ""
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_path\": \"{{corpusPath}}\",\n  \"tenant_id\": \"{{tenantId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest"
              ]
            },
            "description": "Ingest every PDF under `source_path` (resolved on the machine running the API). Default `corpusPath` is `data/raw`, relative to the repo root — the usual cwd when you run `uv run fastapi dev src/agentic_rag_platform/main.py --port 8000`. This re-embeds the full Day 2 corpus and can take several minutes; it also loads the local embedding model on first use. Prefer the single-file request unless you intend a full ingest."
